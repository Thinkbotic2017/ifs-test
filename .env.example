# Copy this file to .env and enter your approved IFS Oracle read-only credentials.
# Never commit the real .env file.
IFS_USER=your_readonly_user
IFS_PASSWORD=replace_me
# Format: hostname:port/service_name (port commonly 1521; ask your DBA for actual values)
IFS_CONNECT_STRING=your-oracle-host:1521/your-service-name

# Local web UI
APP_HOST=127.0.0.1
APP_PORT=3100
QUERY_TIMEOUT_MS=30000





